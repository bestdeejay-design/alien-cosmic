+// «Толстая» видимость: прямая свободна, если свободны и две линии,
+// сдвинутые перпендикулярно на ~полкорпуса (±0.45 тайла ≈ 14 px).
+// Иначе сглаженный путь «чиркал» по углу стены: центральная линия
+// проходила, а корпус (r до 14) цеплял угол и вяз в скольжении.
+function losThick(map, x0, y0, x1, y1) {
+  if (!hasLos(map, x0, y0, x1, y1)) return false;
+  const dx = x1 - x0, dy = y1 - y0;
+  const len = Math.hypot(dx, dy);
+  if (len < 2.2) return true;
+  const ox = Math.round((-dy / len) * 0.45), oy = Math.round((dx / len) * 0.45);
+  if (!ox && !oy) return true;
+  return hasLos(map, x0 + ox, y0 + oy, x1 + ox, y1 + oy) &&
+         hasLos(map, x0 - ox, y0 - oy, x1 - ox, y1 - oy);
+}
+
 // Сглаживание: выбрасываем промежуточные точки, если конец виден напрямую.
 export function smoothPath(map, pts) {
   if (pts.length <= 2) return pts;
@@ -134,7 +149,7 @@ export function smoothPath(map, pts) {
   let i = 0;
   while (i < pts.length - 1) {
     let j = pts.length - 1;
-    for (; j > i + 1; j--) if (hasLos(map, pts[i].x, pts[i].y, pts[j].x, pts[j].y)) break;
+    for (; j > i + 1; j--) if (losThick(map, pts[i].x, pts[i].y, pts[j].x, pts[j].y)) break;
     out.push(pts[j]);
     i = j; // j всегда > i, либо j === i + 1 — цикл гарантированно завершается
   }

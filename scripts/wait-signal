#!/usr/bin/env bash
# wait-signal — ожидание сигнала между сессиями в GitHub issue (v2).
#
# Канал сигналов: label-переходы (status:*) + маркер-комментарии, где первая
# строка тела — маркер единого словаря KNOWLEDGE_BASE §5 (🏁 DONE, ⛔ BLOCKED,
# ❓ QUESTION, 👤 NEEDS-HUMAN, 📬 DELIVERED, 🎯 CONCLUSION, 🟢 GATE OPEN,
# ✋ CLAIM, 🔎 VERDICT, ♻️ RECLAIMED, 🚀 LAUNCH).
# Скрипт только наблюдает: ничего не пишет, кроме режима --claim.
#
# v2 (по AUDIT-V2/RESEARCH-V2): условные запросы ETag (304 не тратит primary
# rate limit у авторизованных запросов — рой может поллить), --since против
# устаревших сигналов, --sha для CI-сигнала, --claim для захвата задачи роем.
#
# Использование:
#   scripts/wait-signal --issue 12 [--repo owner/repo] [--match DONE,BLOCKED]
#                       [--interval 90] [--timeout 3600] [--since 2026-10-27T10:00:00Z]
#                       [--sha <commit-sha>] [--state-dir DIR] [--quiet]
#   scripts/wait-signal --issue 12 --claim "SZ-2 / сессия 2026-10-27-a" --claim-as sz-2
#   scripts/wait-signal --version   # версия + SHA-256 скрипта (проверка свежести клона)
#
# Коды выхода: 0 — сигнал пойман (или захват выигран), 1 — таймаут,
#              2 — ошибка использования/доступа, 3 — задача уже занята (claim).
#
# Только gh CLI и его авторизация. Никаких секретов в аргументах и файлах.

set -u

SCRIPT_VERSION="2.1.0"
script_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$0" 2>/dev/null | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$0" 2>/dev/null | awk '{print $1}'
  else echo "unavailable"; fi
}
print_version() { echo "wait-signal $SCRIPT_VERSION sha256:$(script_sha256) path:$0"; }

ISSUE="" REPO="" MATCH="DONE,BLOCKED,QUESTION,NEEDS-HUMAN,DELIVERED,VERDICT,CLAIM"
INTERVAL=90 TIMEOUT=3600 QUIET=0 SINCE="" SHA="" CLAIM_ID="" CLAIM_AS="" STATE_DIR=""

die() { echo "wait-signal: $*" >&2; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --issue)    ISSUE="${2:-}"; shift 2;;
    --repo)     REPO="${2:-}"; shift 2;;
    --match)    MATCH="${2:-}"; shift 2;;
    --interval) INTERVAL="${2:-}"; shift 2;;
    --timeout)  TIMEOUT="${2:-}"; shift 2;;
    --since)    SINCE="${2:-}"; shift 2;;
    --sha)      SHA="${2:-}"; shift 2;;
    --claim)    CLAIM_ID="${2:-}"; shift 2;;
    --claim-as) CLAIM_AS="${2:-}"; shift 2;;
    --state-dir) STATE_DIR="${2:-}"; shift 2;;
    --quiet)    QUIET=1; shift;;
    --version)  print_version; exit 0;;
    -h|--help)  sed -n '2,34p' "$0"; exit 0;;
    *) die "неизвестный аргумент: $1";;
  esac
done

[ -n "$ISSUE" ] || die "нужен --issue N"
case "$ISSUE" in *[!0-9]*) die "--issue должен быть числом";; esac
case "$CLAIM_AS" in
  ""|owner|coordinator|arena|sz-pool|sz-1|sz-2|sz-3|sz-4|sz-5) :;;
  *) die "--claim-as должен быть owner|coordinator|arena|sz-pool|sz-1..sz-5";;
esac
command -v gh >/dev/null 2>&1 || die "gh CLI не найден"
gh auth status >/dev/null 2>&1 || die "gh не авторизован"
# Свежесть скрипта видна сразу: старый клон не имеет права ждать молча.
[ "$QUIET" -eq 0 ] && print_version >&2 || true

# --- репозиторий: --repo → git remote origin → gh repo view (последний шанс) ---
# REST/remote-путь не зависит от GraphQL (по опыту: GraphQL бывает урезан).
if [ -z "$REPO" ]; then
  REMOTE_URL="$(git remote get-url origin 2>/dev/null || true)"
  REPO="$(printf '%s' "$REMOTE_URL" | sed -n 's#.*github\.com[/:]\(.*\)\.git$#\1#p')"
  [ -z "$REPO" ] && REPO="$(printf '%s' "$REMOTE_URL" | sed -n 's#.*github\.com[/:]\([^/]*/[^/]*\)$#\1#p')"
fi
if [ -z "$REPO" ]; then
  REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
fi
[ -n "$REPO" ] || die "не удалось определить репозиторий (укажите --repo owner/repo)"
case "$REPO" in */*) :;; *) die "--repo должен быть в формате owner/repo";; esac

# --- кэш ETag: один каталог на пару repo+issue, переиспользуется между поллами ---
STATE_DIR="${STATE_DIR:-${TMPDIR:-/tmp}/wait-signal-$(printf '%s' "${REPO}_${ISSUE}" | tr '/ ' '__')}"
mkdir -p "$STATE_DIR" 2>/dev/null || die "не создать каталог состояния: $STATE_DIR"

dbg() { [ "${WS_DEBUG:-0}" = "1" ] && echo "wait-signal[debug]: $*" >&2 || true; }

# fetch_conditional KEY URL JQEXPR
# Заполняет globals: HTTP_STATUS, BODY_FILE (файл с производными строками тела).
# На 304 тело берётся из кэша прошлой 200-ответа; свежий ETag сохраняется на 200.
HTTP_STATUS="" BODY_FILE=""
fetch_conditional() {
  local key="$1" url="$2" jqexpr="$3" raw etag hdr_status
  raw="$(mktemp)"
  etag=""
  [ -f "$STATE_DIR/$key.etag" ] && etag="$(cat "$STATE_DIR/$key.etag")"
  if [ -n "$etag" ]; then
    gh api -i "$url" -H "If-None-Match: $etag" --jq "$jqexpr" >"$raw" 2>/dev/null
  else
    gh api -i "$url" --jq "$jqexpr" >"$raw" 2>/dev/null
  fi
  # gh завершается ненулевым кодом на 304 (пустое тело для jq) — статус читаем из заголовков.
  hdr_status="$(head -n 1 "$raw" | tr -d '\r' | awk '{print $2}')"
  HTTP_STATUS="$hdr_status"
  dbg "$key -> HTTP $HTTP_STATUS (etag cached: $([ -n "$etag" ] && echo yes || echo no))"
  case "$HTTP_STATUS" in
    200)
      grep -i '^etag:' "$raw" | head -n 1 | tr -d '\r' | cut -d' ' -f2- > "$STATE_DIR/$key.etag"
      awk 'BEGIN{body=0} /^\r?$/{if(!body){body=1; next}} body{print}' "$raw" > "$STATE_DIR/$key.body"
      BODY_FILE="$STATE_DIR/$key.body"
      ;;
    304)
      BODY_FILE="$STATE_DIR/$key.body"
      [ -f "$BODY_FILE" ] || BODY_FILE=""
      ;;
    404|422)
      # Для check-runs это значит «CI ещё нет / коммит не запушен» — не сигнал, не смерть.
      if [ "$key" = "checks" ]; then rm -f "$raw"; BODY_FILE=""; return 1; fi
      rm -f "$raw"; die "GitHub ответил $HTTP_STATUS по $url (доступ/права)";;
    401|403) rm -f "$raw"; die "GitHub ответил $HTTP_STATUS по $url (доступ/права)";;
    *) rm -f "$raw"; echo "wait-signal: временный сбой HTTP $HTTP_STATUS по $url" >&2; BODY_FILE=""; return 1;;
  esac
  rm -f "$raw"
  return 0
}

match_any() { # match_any LINE -> 0 если первая строка несёт запрошенный маркер
  local line="$1" m key
  local IFS_SAVE="$IFS"; IFS=','
  for m in $MATCH; do
    m="$(printf '%s' "$m" | sed 's/^ *//; s/ *$//')"
    [ -z "$m" ] && continue
    case "$line" in *"$m"*) IFS="$IFS_SAVE"; return 0;; esac
  done
  IFS="$IFS_SAVE"
  return 1
}

# Метка времени ISO из DERIVED-строк комментариев (формат: created_at<TAB>первая строка)
line_matches_since() {
  [ -z "$SINCE" ] && return 0
  local ts="" rest=""
  IFS=$'\t' read -r ts rest <<< "$1"
  [ -z "${rest:-}" ] && return 0   # строка без временной метки — не отсекаем
  [[ ! "$ts" < "$SINCE" ]]
}

check_signals() {
  # --- само issue: labels + первая строка тела ---
  fetch_conditional "issue" "repos/$REPO/issues/$ISSUE" \
    '"LABELS\t" + ([.labels[].name] | join(",")) , "UPDATED\t" + (.updated_at // "") , "FIRST\t" + ((.body // "") | split("\n")[0])' || return 1
  if [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ]; then
    local labels_line first_line updated_line lbl fresh=1
    labels_line="$(grep '^LABELS' "$BODY_FILE" | head -n 1 | cut -f2)"
    updated_line="$(grep '^UPDATED' "$BODY_FILE" | head -n 1 | cut -f2)"
    first_line="$(grep '^FIRST' "$BODY_FILE" | head -n 1 | cut -f2-)"
    # --since отсекает и маркер тела, если issue не обновлялось с порога:
    # иначе DONE прошлого цикла снова «сработает» в новом ожидании.
    if [ -n "$SINCE" ] && [ -n "${updated_line:-}" ] && [[ "$updated_line" < "$SINCE" ]]; then fresh=0; fi
    IFS=',' read -ra _lbls <<< "${labels_line:-}"
    for lbl in "${_lbls[@]:-}"; do
      [ -n "$lbl" ] && printf 'LABEL %s\n' "$lbl"
    done
    [ -n "${first_line:-}" ] && printf 'FIRSTLINE %s\n' "$first_line"
    if [ "$fresh" -eq 1 ] && [ -n "${first_line:-}" ] && match_any "$first_line"; then
      echo "SIGNAL issue-body: $first_line"
      return 0
    fi
  fi
  # --- комментарии: первая страница самых свежих правок через since; производная
  #     строка несёт created_at, чтобы --since отсекал сигналы прошлого цикла ---
  local comments_url="repos/$REPO/issues/$ISSUE/comments?per_page=100"
  [ -n "$SINCE" ] && comments_url="$comments_url&since=$SINCE"
  fetch_conditional "comments" "$comments_url" \
    '.[] | .created_at + "\t" + ((.body // "") | split("\n")[0])' || return 1
  if [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ]; then
    local cline cfirst
    while IFS= read -r cline; do
      [ -z "$cline" ] && continue
      line_matches_since "$cline" || continue
      cfirst="$(printf '%s' "$cline" | cut -f2-)"
      printf 'COMMENT %s\n' "$cfirst"
      if match_any "$cfirst"; then
        echo "SIGNAL comment: $cfirst"
        return 0
      fi
    done < "$BODY_FILE"
  fi
  # --- CI: check-runs коммита; сигнал — только завершённый набор ---
  if [ -n "$SHA" ]; then
    fetch_conditional "checks" "repos/$REPO/commits/$SHA/check-runs?per_page=100" \
      '"TOTAL\t" + (.total_count|tostring) , (.check_runs[] | .status + "\t" + (.conclusion // "-"))' || return 1
    if [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ]; then
      local total done_cnt fails
      total="$(grep '^TOTAL' "$BODY_FILE" | head -n 1 | cut -f2)"
      if [ "${total:-0}" -gt 0 ] 2>/dev/null; then
        done_cnt="$(grep -c '^completed' "$BODY_FILE" || true)"
        printf 'CI %s/%s completed\n' "$done_cnt" "$total"
        if [ "$done_cnt" -eq "$total" ]; then
          fails="$(grep '^completed' "$BODY_FILE" | grep -vc 'success' || true)"
          if [ "$fails" -eq 0 ]; then
            echo "SIGNAL ci: ✅ CI #$ISSUE — checks: success ${SHA:0:7}"
          else
            echo "SIGNAL ci: ✅ CI #$ISSUE — checks: completed-with-failures ${SHA:0:7}"
          fi
          return 0
        fi
      fi
    fi
  fi
  return 1
}

# --- режим захвата задачи роем (optimistic claim; честные ограничения — в KNOWLEDGE_BASE §5.1) ---
do_claim() {
  local labels first_claim
  labels="$(gh api "repos/$REPO/issues/$ISSUE" --jq '[.labels[].name] | join(",")' 2>/dev/null)" \
    || die "claim: не прочитать issue #$ISSUE"
  case ",$labels," in *",status:in-progress,"*) echo "BUSY: задача уже в работе ($labels)"; exit 3;; esac
  first_claim="$(gh api "repos/$REPO/issues/$ISSUE/comments?per_page=100" \
    --jq '[.[] | select((.body // "") | startswith("✋ CLAIM"))] | sort_by(.created_at) | if length == 0 then "" else .[0] | (.created_at + "\t" + ((.body // "") | split("\n")[0])) end' 2>/dev/null || true)"
  resume_claim=0
  if [ -n "$first_claim" ]; then
    case "$first_claim" in
      *"$CLAIM_ID"*)
        # Собственный claim-комментарий без смены labels = след прерванной попытки.
        # Не клиним задачу навсегда: ниже только повторяем PATCH labels.
        resume_claim=1
        echo "RESUME: найден собственный незавершённый claim, повторяю перевод labels" >&2;;
      *) echo "BUSY: есть claim: $first_claim"; exit 3;;
    esac
  fi
  case ",$labels," in *",status:ready,"*) :;; *) echo "NOT-READY: захват возможен только из status:ready (сейчас: $labels)"; exit 3;; esac

  local now args=() l _old=() _nl=() claim_comment_id=""
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ "${resume_claim:-0}" -ne 1 ]; then
    claim_comment_id="$(gh api "repos/$REPO/issues/$ISSUE/comments" -f body="✋ CLAIM #$ISSUE — взял: $CLAIM_ID
— роль/сессия: $CLAIM_ID · heartbeat: продлеваю комментарием каждые 30 минут работы" --jq '.id' 2>/dev/null)" \
      || die "claim: не удалось оставить claim-комментарий (нет прав записи?)"
    [ -n "$claim_comment_id" ] || die "claim: GitHub не вернул ID claim-комментария"
  fi
  IFS=',' read -ra _old <<< "$labels"
  for l in "${_old[@]}"; do
    [ -z "$l" ] && continue
    [ "$l" = "status:ready" ] && l="status:in-progress"
    case "$l" in
      to:*) [ -n "$CLAIM_AS" ] && continue;;
    esac
    _nl+=("$l")
  done
  [ -n "$CLAIM_AS" ] && _nl+=("to:$CLAIM_AS")
  for l in "${_nl[@]}"; do args+=(-f "labels[]=$l"); done
  if ! gh api -X PATCH "repos/$REPO/issues/$ISSUE" "${args[@]}" >/dev/null 2>&1; then
    # Не оставляем висячий claim: комментарий без перехода labels не должен
    # навсегда делать задачу BUSY. Удаляем только собственный комментарий.
    if [ -n "$claim_comment_id" ] && gh api -X DELETE "repos/$REPO/issues/comments/$claim_comment_id" >/dev/null 2>&1; then
      die "claim: не удалось перевести label в in-progress; собственный claim-комментарий #$claim_comment_id удалён, задача не заклинена"
    fi
    die "claim: не удалось перевести label в in-progress; проверьте claim-комментарий ${claim_comment_id:-без ID} вручную, чтобы задача не осталась BUSY"
  fi

  # Арбитраж: GitHub не даёт атомарного CAS на labels — после короткой паузы
  # перечитываем: выигрывает самый ранний claim-комментарий; проигравший отступает.
  sleep 3
  first_claim="$(gh api "repos/$REPO/issues/$ISSUE/comments?per_page=100" \
    --jq '[.[] | select((.body // "") | startswith("✋ CLAIM"))] | sort_by(.created_at) | if length == 0 then "" else .[0] | ((.body // "") | split("\n")[0]) end' 2>/dev/null || true)"
  case "$first_claim" in
    *"$CLAIM_ID"*) echo "CLAIMED: $first_claim"; exit 0;;
    *) echo "LOST: задачу взял другой: $first_claim (ваш claim-комментарий остаётся следом аудита; не трогайте labels)"; exit 3;;
  esac
}

[ -n "$CLAIM_ID" ] && do_claim

# --- цикл ожидания ---
DEADLINE=$(( $(date +%s) + TIMEOUT ))
while :; do
  OUT="$(check_signals)"
  SIG="$(printf '%s\n' "$OUT" | grep '^SIGNAL' | head -n 1 || true)"
  if [ -n "$SIG" ]; then
    [ "$QUIET" -eq 0 ] && echo "[$(date -u +%H:%M:%SZ)] пойман сигнал в issue #$ISSUE ($REPO)" >&2
    echo "${SIG#SIGNAL }"
    exit 0
  fi
  [ "$QUIET" -eq 0 ] && echo "[$(date -u +%H:%M:%SZ)] issue #$ISSUE: сигнала нет; labels/комментарии/CI проверены, следующий поллинг через ${INTERVAL}с" >&2
  NOW=$(date +%s)
  [ "$NOW" -ge "$DEADLINE" ] && { echo "wait-signal: таймаут ${TIMEOUT}с без сигнала в issue #$ISSUE" >&2; exit 1; }
  REMAIN=$(( DEADLINE - NOW ))
  [ "$INTERVAL" -gt "$REMAIN" ] && sleep "$REMAIN" || sleep "$INTERVAL"
done

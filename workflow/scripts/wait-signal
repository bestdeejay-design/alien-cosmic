#!/usr/bin/env bash
# wait-signal — ожидание сигнала между сессиями в GitHub issue (v2).
#
# Канал сигналов: label-переходы (status:*) + маркер-комментарии, где первая
# строка тела — маркер единого словаря KNOWLEDGE_BASE §5 (🏁 DONE, ⛔ BLOCKED,
# ❓ QUESTION, 👤 NEEDS-HUMAN, 📬 DELIVERED, 🎯 CONCLUSION, ✅ GATE OPEN,
# ✋ CLAIM, 🔎 VERDICT, ♻️ RECLAIMED, 🚀 LAUNCH).
# Скрипт только наблюдает: ничего не пишет, кроме режима --claim.
#
# v2 (по AUDIT-V2/RESEARCH-V2): условные запросы ETag (304 не тратит primary
# rate limit у авторизованных запросов — рой может поллить), --since против
# устаревших сигналов, --sha для CI-сигнала, --claim для захвата задачи роем.
#
# Использование:
#   scripts/wait-signal --issue 12 [--repo owner/repo] [--match DONE,BLOCKED]
#                       [--interval 90] [--timeout 3600] [--since 2026-10-27T10:00:00Z]
#                       [--sha <commit-sha>] [--state-dir DIR] [--quiet]
#   scripts/wait-signal --issue 12 --claim "SZ-2 / сессия 2026-10-27-a" --claim-as sz-2
#   scripts/wait-signal --version   # версия + SHA-256 скрипта (проверка свежести клона)
#
# Коды выхода: 0 — сигнал пойман (или захват выигран), 1 — таймаут,
#              2 — ошибка использования/доступа, 3 — задача уже занята (claim).
#
# Только gh CLI и его авторизация. Никаких секретов в аргументах и файлах.
#
# v2.2.0 (аудит внешнего исполнения):
#   - маркер распознаётся как отдельный токен первой строки ("NOTDONE" больше
#     не матчится как "DONE" подстрочным кейсом);
#   - комментарии читаются постранично (per_page=100, кэш ETag на comments-pN);
#   - BUSY при claim упоминает свежий ♻️ RECLAIMED, если он найден;
#   - check-runs завершённые ДО старта ожидания не выдаются как CI-сигнал;
#   - die (404/401/403) внутри check_signals больше не маскируется таймаутом
#     (код выхода 2 пробрасывается из subshell).
#
# v2.2.1 (D-002, issue #19): граница маркера в match_any строже — дефисная
#   склейка после маркера ("DONE-ish", "NEEDS-HUMAN-ISH") не матчится;
#   "DONE.", "DONE,see", "DONE #1", "DONE" (конец строки) — матчатся.
#
# v2.2.2 (D-003, issue #20): удалён мёртвый ранний останов пагинации
#   комментариев по last_ts<SINCE — since серверный и инклюзивен, условие
#   недостижимо; конец пагинации — неполная страница (<100 строк).
#
# v2.2.3 (D-004, issue #21): диагностические строки CI («CI N/M completed»,
#   «CI stale: …») переведены в stderr с подчинением --quiet; в stdout
#   остаются только сигнальные строки.
#
# v2.2.4 (D-005, issue #22): check-runs читаются постранично (page=N,
#   ETag-кэш checks-pN); total/done суммируются по всем страницам, ранний
#   останов — неполная/пустая страница; CI-сигнал — только когда собраны
#   все страницы и done == total (при >100 checks сигнал раньше не срабатывал).
#
# v2.2.5 (issue #30): claim из status:ready при чужом first_claim больше не
#   падает в BUSY вслепую — если в desc-истории ПОСЛЕ этого claim есть более
#   свежий ♻️ RECLAIMED, задача свободна: claim продолжается (арбитражная
#   перепроверка после sleep 3 учитывает мёртвые pre-reclaim claims). CLAIM
#   свежее RECLAIMED (или RECLAIMED нет) — прежний BUSY exit 3. Ветка
#   in-progress (D-001) не изменена. Компромисс (см. DEBT D-006): на
#   RECLAIMED-нутой задаче (ready + мёртвый pre-reclaim claim) два претендента
#   могут ОБА получить CLAIMED — окно секунды, оба claim-комментария остаются
#   следом аудита, конфликт разруливает координатор.

set -u

SCRIPT_VERSION="2.2.5"
script_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$0" 2>/dev/null | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$0" 2>/dev/null | awk '{print $1}'
  else echo "unavailable"; fi
}
print_version() { echo "wait-signal $SCRIPT_VERSION sha256:$(script_sha256) path:$0"; }

ISSUE="" REPO="" MATCH="DONE,BLOCKED,QUESTION,NEEDS-HUMAN,DELIVERED,VERDICT,CLAIM"
INTERVAL=90 TIMEOUT=3600 QUIET=0 SINCE="" SHA="" CLAIM_ID="" CLAIM_AS="" STATE_DIR=""

die() { echo "wait-signal: $*" >&2; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --issue)    ISSUE="${2:-}"; shift 2;;
    --repo)     REPO="${2:-}"; shift 2;;
    --match)    MATCH="${2:-}"; shift 2;;
    --interval) INTERVAL="${2:-}"; shift 2;;
    --timeout)  TIMEOUT="${2:-}"; shift 2;;
    --since)    SINCE="${2:-}"; shift 2;;
    --sha)      SHA="${2:-}"; shift 2;;
    --claim)    CLAIM_ID="${2:-}"; shift 2;;
    --claim-as) CLAIM_AS="${2:-}"; shift 2;;
    --state-dir) STATE_DIR="${2:-}"; shift 2;;
    --quiet)    QUIET=1; shift;;
    --version)  print_version; exit 0;;
    -h|--help)  sed -n '2,34p' "$0"; exit 0;;
    *) die "неизвестный аргумент: $1";;
  esac
done

[ -n "$ISSUE" ] || die "нужен --issue N"
case "$ISSUE" in *[!0-9]*) die "--issue должен быть числом";; esac
case "$INTERVAL" in ''|*[!0-9]*) die "--interval должен быть целым числом (секунды)";; esac
case "$TIMEOUT" in ''|*[!0-9]*) die "--timeout должен быть целым числом (секунды)";; esac
case "$CLAIM_AS" in
  ""|owner|coordinator|arena|sz-pool|sz-1|sz-2|sz-3|sz-4|sz-5) :;;
  *) die "--claim-as должен быть owner|coordinator|arena|sz-pool|sz-1..sz-5";;
esac
command -v gh >/dev/null 2>&1 || die "gh CLI не найден"
gh auth status >/dev/null 2>&1 || die "gh не авторизован"
# Свежесть скрипта видна сразу: старый клон не имеет права ждать молча.
[ "$QUIET" -eq 0 ] && print_version >&2 || true

# --- репозиторий: --repo → git remote origin → gh repo view (последний шанс) ---
# REST/remote-путь не зависит от GraphQL (по опыту: GraphQL бывает урезан).
if [ -z "$REPO" ]; then
  REMOTE_URL="$(git remote get-url origin 2>/dev/null || true)"
  REPO="$(printf '%s' "$REMOTE_URL" | sed -n 's#.*github\.com[/:]\(.*\)\.git$#\1#p')"
  [ -z "$REPO" ] && REPO="$(printf '%s' "$REMOTE_URL" | sed -n 's#.*github\.com[/:]\([^/]*/[^/]*\)$#\1#p')"
fi
if [ -z "$REPO" ]; then
  REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
fi
[ -n "$REPO" ] || die "не удалось определить репозиторий (укажите --repo owner/repo)"
case "$REPO" in */*) :;; *) die "--repo должен быть в формате owner/repo";; esac

# --- кэш ETag: один каталог на пару repo+issue, переиспользуется между поллами ---
STATE_DIR="${STATE_DIR:-${TMPDIR:-/tmp}/wait-signal-$(printf '%s' "${REPO}_${ISSUE}" | tr '/ ' '__')}"
mkdir -p "$STATE_DIR" 2>/dev/null || die "не создать каталог состояния: $STATE_DIR"

dbg() { [ "${WS_DEBUG:-0}" = "1" ] && echo "wait-signal[debug]: $*" >&2 || true; }

# fetch_conditional KEY URL JQEXPR
# Заполняет globals: HTTP_STATUS, BODY_FILE (файл с производными строками тела).
# На 304 тело берётся из кэша прошлой 200-ответа; свежий ETag сохраняется на 200.
HTTP_STATUS="" BODY_FILE=""
fetch_conditional() {
  local key="$1" url="$2" jqexpr="$3" raw etag hdr_status
  raw="$(mktemp)"
  etag=""
  [ -f "$STATE_DIR/$key.etag" ] && etag="$(cat "$STATE_DIR/$key.etag")"
  if [ -n "$etag" ]; then
    gh api -i "$url" -H "If-None-Match: $etag" --jq "$jqexpr" >"$raw" 2>/dev/null
  else
    gh api -i "$url" --jq "$jqexpr" >"$raw" 2>/dev/null
  fi
  # gh завершается ненулевым кодом на 304 (пустое тело для jq) — статус читаем из заголовков.
  hdr_status="$(head -n 1 "$raw" | tr -d '\r' | awk '{print $2}')"
  HTTP_STATUS="$hdr_status"
  dbg "$key -> HTTP $HTTP_STATUS (etag cached: $([ -n "$etag" ] && echo yes || echo no))"
  case "$HTTP_STATUS" in
    200)
      grep -i '^etag:' "$raw" | head -n 1 | tr -d '\r' | cut -d' ' -f2- > "$STATE_DIR/$key.etag"
      awk 'BEGIN{body=0} /^\r?$/{if(!body){body=1; next}} body{print}' "$raw" > "$STATE_DIR/$key.body"
      BODY_FILE="$STATE_DIR/$key.body"
      ;;
    304)
      BODY_FILE="$STATE_DIR/$key.body"
      [ -f "$BODY_FILE" ] || BODY_FILE=""
      ;;
    404|422)
      # Для страниц check-runs (checks-pN) это значит «CI ещё нет / коммит не
      # запушен / страницы кончились» — не сигнал, не смерть.
      case "$key" in
        checks-*) rm -f "$raw"; BODY_FILE=""; return 1;;
      esac
      rm -f "$raw"; die "GitHub ответил $HTTP_STATUS по $url (доступ/права)";;
    401|403) rm -f "$raw"; die "GitHub ответил $HTTP_STATUS по $url (доступ/права)";;
    *) rm -f "$raw"; echo "wait-signal: временный сбой HTTP $HTTP_STATUS по $url" >&2; BODY_FILE=""; return 1;;
  esac
  rm -f "$raw"
  return 0
}

match_any() { # match_any LINE -> 0 если строка НАЧИНАЕТСЯ с запрошенного маркера
  # Маркер — отдельный токен: "🏁 DONE #1" матчится, "NOTDONE #1" — нет
  # (ведущее не-алфавитное обрамление строки срезается). Граница после маркера
  # строже, чем «любая пунктуация»: дефисная склейка ("DONE-ish") не матчится —
  # это одно слово; прочая пунктуация-разделитель ("DONE.", "DONE,see") и
  # конец строки — матчатся; буква/цифра вплотную ("DONE2") — нет.
  local line="$1" m key cmp rest
  cmp="$(printf '%s' "$line" | sed 's/^[^[:alnum:]]*//')"
  local IFS_SAVE="$IFS"; IFS=','
  for m in $MATCH; do
    m="$(printf '%s' "$m" | sed 's/^ *//; s/ *$//')"
    [ -z "$m" ] && continue
    case "$cmp" in
      "$m") IFS="$IFS_SAVE"; return 0;;
      "$m"*)
        rest="${cmp#"$m"}"
        if [[ "$rest" =~ ^[[:space:][:punct:]]+$ ]]; then
          IFS="$IFS_SAVE"; return 0        # после маркера только пробел/пунктуация до конца строки
        elif [[ "$rest" =~ ^[[:space:][:punct:]]*-[[:alnum:]] ]]; then
          :                                # дефисная склейка ("DONE-ish") — одно слово, не маркер
        elif [[ "$rest" =~ ^[[:space:][:punct:]]+[[:alnum:]] ]]; then
          IFS="$IFS_SAVE"; return 0        # пунктуация-разделитель ("DONE,see", "DONE? да") — маркер
        fi;;
    esac
  done
  IFS="$IFS_SAVE"
  return 1
}

# Метка времени ISO из DERIVED-строк комментариев (формат: created_at<TAB>первая строка)
line_matches_since() {
  [ -z "$SINCE" ] && return 0
  local ts="" rest=""
  IFS=$'\t' read -r ts rest <<< "$1"
  [ -z "${rest:-}" ] && return 0   # строка без временной метки — не отсекаем
  [[ ! "$ts" < "$SINCE" ]]
}

check_signals() {
  # --- само issue: labels + первая строка тела ---
  fetch_conditional "issue" "repos/$REPO/issues/$ISSUE" \
    '"LABELS\t" + ([.labels[].name] | join(",")) , "UPDATED\t" + (.updated_at // "") , "FIRST\t" + ((.body // "") | split("\n")[0])' || return 1
  if [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ]; then
    local labels_line first_line updated_line lbl fresh=1
    labels_line="$(grep '^LABELS' "$BODY_FILE" | head -n 1 | cut -f2)"
    updated_line="$(grep '^UPDATED' "$BODY_FILE" | head -n 1 | cut -f2)"
    first_line="$(grep '^FIRST' "$BODY_FILE" | head -n 1 | cut -f2-)"
    # --since отсекает и маркер тела, если issue не обновлялось с порога:
    # иначе DONE прошлого цикла снова «сработает» в новом ожидании.
    if [ -n "$SINCE" ] && [ -n "${updated_line:-}" ] && [[ "$updated_line" < "$SINCE" ]]; then fresh=0; fi
    IFS=',' read -ra _lbls <<< "${labels_line:-}"
    for lbl in "${_lbls[@]:-}"; do
      [ -n "$lbl" ] && printf 'LABEL %s\n' "$lbl"
    done
    [ -n "${first_line:-}" ] && printf 'FIRSTLINE %s\n' "$first_line"
    if [ "$fresh" -eq 1 ] && [ -n "${first_line:-}" ] && match_any "$first_line"; then
      echo "SIGNAL issue-body: $first_line"
      return 0
    fi
  fi
  # --- комментарии: постранично (per_page=100); производная строка несёт
  #     created_at, чтобы --since отсекал сигналы прошлого цикла. ETag-кэш
  #     заводится на страницу (comments-pN). Комментарии REST отдаёт по
  #     возрастанию created_at. Критерий конца пагинации — неполная страница:
  #     since применяется серверно и инклюзивен (все возвращённые created_at
  #     >= SINCE), поэтому отдельная проверка «страница целиком старше SINCE»
  #     недостижима и не нужна. ---
  local p=1 cpage_url lines_in_page
  while :; do
    cpage_url="repos/$REPO/issues/$ISSUE/comments?per_page=100&page=$p"
    [ -n "$SINCE" ] && cpage_url="$cpage_url&since=$SINCE"
    fetch_conditional "comments-p$p" "$cpage_url" \
      '.[] | .created_at + "\t" + ((.body // "") | split("\n")[0])' || return 1
    if [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ]; then
      local cline cfirst
      lines_in_page=0
      while IFS= read -r cline; do
        [ -z "$cline" ] && continue
        lines_in_page=$((lines_in_page + 1))
        line_matches_since "$cline" || continue
        cfirst="$(printf '%s' "$cline" | cut -f2-)"
        printf 'COMMENT %s\n' "$cfirst"
        if match_any "$cfirst"; then
          echo "SIGNAL comment: $cfirst"
          return 0
        fi
      done < "$BODY_FILE"
      # конец пагинации — только неполная страница (см. комментарий выше)
      [ "$lines_in_page" -lt 100 ] && break
    else
      break
    fi
    p=$((p + 1))
    [ "$p" -gt 50 ] && break  # предохранитель от вечного поллинга
  done
  # --- CI: check-runs коммита, постранично (per_page=100, ETag-кэш checks-pN);
  #     суммарные total/done собираются по всем страницам, ранний останов —
  #     неполная или пустая страница (как у комментариев). Сигнал — только
  #     завершённый набор со ВСЕХ страниц (done == total), причём завершённый
  #     НЕ до старта ожидания (иначе CI прошлого запуска по тому же SHA
  #     мгновенно «срабатывает» при новом ожидании) ---
  if [ -n "$SHA" ]; then
    local cp=1 total=0 done_cnt=0 fails_cnt=0 page_rows pfails newest newest_page
    newest=""
    while :; do
      if ! fetch_conditional "checks-p$cp" "repos/$REPO/commits/$SHA/check-runs?per_page=100&page=$cp" \
        '"TOTAL\t" + (.total_count|tostring) , (.check_runs[] | .status + "\t" + (.conclusion // "-") + "\t" + (.updated_at // ""))'; then
        if [ "$cp" -eq 1 ]; then return 1; else break; fi  # стр. 1: нет CI; дальше: страницы кончились
      fi
      [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ] || break
      total="$(grep '^TOTAL' "$BODY_FILE" | head -n 1 | cut -f2)"
      page_rows="$(grep -vc '^TOTAL' "$BODY_FILE" || true)"
      done_cnt=$(( done_cnt + $(grep -c '^completed' "$BODY_FILE" || true) ))
      pfails="$(grep '^completed' "$BODY_FILE" | grep -vc 'success' || true)"
      fails_cnt=$(( fails_cnt + pfails ))
      newest_page="$(grep '^completed' "$BODY_FILE" | cut -f3 | sort | tail -n 1)"
      { [ -z "$newest" ] || [[ "$newest_page" > "$newest" ]]; } && [ -n "$newest_page" ] && newest="$newest_page"
      # конец пагинации — неполная (<100 строк) или пустая страница
      [ "$page_rows" -lt 100 ] && break
      cp=$((cp + 1))
      [ "$cp" -gt 50 ] && break  # предохранитель от вечного поллинга
    done
    if [ "${total:-0}" -gt 0 ] 2>/dev/null; then
      # диагностические строки — в stderr (в stdout уходят только SIGNAL-*,
      # иначе цикл ожидания их глотает и причина таймаута невидима); подчинены QUIET
      [ "$QUIET" -eq 0 ] && printf 'CI %s/%s completed\n' "$done_cnt" "$total" >&2
      if [ "$done_cnt" -eq "$total" ]; then
        if [ -n "$WAIT_START" ] && [ -n "$newest" ] && [[ "$newest" < "$WAIT_START" ]]; then
          [ "$QUIET" -eq 0 ] && printf 'CI stale: все checks завершились до старта ожидания (%s), не сигнал\n' "$newest" >&2
        else
          if [ "$fails_cnt" -eq 0 ]; then
            echo "SIGNAL ci: ✅ CI #$ISSUE — checks: success ${SHA:0:7}"
          else
            echo "SIGNAL ci: ✅ CI #$ISSUE — checks: completed-with-failures ${SHA:0:7}"
          fi
          return 0
        fi
      fi
    fi
  fi
  return 1
}

# --- режим захвата задачи роем (optimistic claim; честные ограничения — в KNOWLEDGE_BASE §5.1) ---
# oldest_claim: «created_at<TAB>первая строка» самого раннего claim в desc-выборке
# (арбитраж по-прежнему выигрывает самый ранний claim).
oldest_claim() {
  gh api "repos/$REPO/issues/$ISSUE/comments?per_page=100&sort=created&direction=desc" \
    --jq '[.[] | select((.body // "") | startswith("✋ CLAIM"))] | if length == 0 then "" else .[-1] | (.created_at + "\t" + ((.body // "") | split("\n")[0])) end' 2>/dev/null || true
}
# latest_reclaimed: created_at самого свежего ♻️ RECLAIMED ("" — если нет).
latest_reclaimed() {
  gh api "repos/$REPO/issues/$ISSUE/comments?per_page=100&sort=created&direction=desc" \
    --jq '[.[] | select((.body // "") | startswith("♻️ RECLAIMED"))] | if length == 0 then "" else .[0] | .created_at end' 2>/dev/null || true
}
# reclaim_frees CLAIM_TS: успех (0), если есть RECLAIMED свежее указанного claim.
reclaim_frees() {
  [ -n "$1" ] || return 1
  local lr
  lr="$(latest_reclaimed)"
  [ -n "$lr" ] && [[ "$lr" > "$1" ]]
}

do_claim() {
  local labels first_claim claim_header
  claim_header="✋ CLAIM #$ISSUE — взял: $CLAIM_ID"
  labels="$(gh api "repos/$REPO/issues/$ISSUE" --jq '[.labels[].name] | join(",")' 2>/dev/null)" \
    || die "claim: не прочитать issue #$ISSUE"
  case ",$labels," in
    *",status:in-progress,"*)
      # in-progress не всегда BUSY: свежий ♻️ RECLAIMED значит, что задачу
      # освободили, а label не вернули — сообщаем это, контракт кода 3 не меняем.
      # Запрос идёт с sort=created&direction=desc: при >100 комментариях свежий
      # RECLAIMED остаётся в первом (самом новом) окне выборки.
      reclaimed="$(gh api "repos/$REPO/issues/$ISSUE/comments?per_page=100&sort=created&direction=desc" \
        --jq '[.[] | select((.body // "") | startswith("♻️ RECLAIMED"))] | if length == 0 then "" else .[0] | .created_at end' 2>/dev/null || true)"
      if [ -n "$reclaimed" ]; then
        echo "BUSY: label status:in-progress ($labels), но найден сигнал ♻️ RECLAIMED ($reclaimed) — задача возможно освобождена, проверьте вручную"
      else
        echo "BUSY: задача уже в работе ($labels)"
      fi
      exit 3;;
  esac
  first_claim="$(oldest_claim)"
  resume_claim=0
  if [ -n "$first_claim" ]; then
    local claim_ts="${first_claim%%$'\t'*}" claim_line="${first_claim#*$'\t'}"
    case "$claim_line" in
      "$claim_header")
        # Собственный claim-комментарий без смены labels = след прерванной попытки.
        # Не клиним задачу навсегда: ниже только повторяем PATCH labels.
        resume_claim=1
        echo "RESUME: найден собственный незавершённый claim, повторяю перевод labels" >&2;;
      *)
        # Чужой claim не всегда занятость: если после него в истории был более
        # свежий ♻️ RECLAIMED, задачу освободили, а labels не вернули — ведём
        # себя как свободная задача и продолжаем claim.
        if reclaim_frees "$claim_ts"; then
          echo "FREE: после чужого claim ($claim_line) найден более свежий ♻️ RECLAIMED — задача свободна, продолжаю claim" >&2
        else
          echo "BUSY: есть claim: $claim_line"; exit 3
        fi;;
    esac
  fi
  case ",$labels," in *",status:ready,"*) :;; *) echo "NOT-READY: захват возможен только из status:ready (сейчас: $labels)"; exit 3;; esac

  local now args=() l _old=() _nl=() claim_comment_id=""
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ "${resume_claim:-0}" -ne 1 ]; then
    claim_comment_id="$(gh api "repos/$REPO/issues/$ISSUE/comments" -f body="✋ CLAIM #$ISSUE — взял: $CLAIM_ID
— роль/сессия: $CLAIM_ID · heartbeat: продлеваю комментарием каждые 30 минут работы" --jq '.id' 2>/dev/null)" \
      || die "claim: не удалось оставить claim-комментарий (нет прав записи?)"
    [ -n "$claim_comment_id" ] || die "claim: GitHub не вернул ID claim-комментария"
  fi

  # Арбитраж ДО перевода labels: GitHub не даёт атомарного CAS на labels —
  # после короткой паузы перечитываем claim-комментарии. Выигрывает самый ранний
  # claim; проигравший отступает и labels не трогает вовсе (KNOWLEDGE_BASE §5.1).
  sleep 3
  first_claim="$(oldest_claim)"
  if [ -n "$first_claim" ]; then
    local claim_ts="${first_claim%%$'\t'*}" claim_line="${first_claim#*$'\t'}"
    case "$claim_line" in
      "$claim_header") :;;
      *)
        # Мёртвый pre-reclaim claim в истории арбитраж не портит: он старше
        # RECLAIMED, значит никого живого не представляет.
        if reclaim_frees "$claim_ts"; then :; else
          echo "LOST: задачу взял другой: $claim_line (ваш claim-комментарий остаётся следом аудита; не трогайте labels)"; exit 3
        fi;;
    esac
  fi

  IFS=',' read -ra _old <<< "$labels"
  for l in "${_old[@]:-}"; do
    [ -z "$l" ] && continue
    [ "$l" = "status:ready" ] && l="status:in-progress"
    case "$l" in
      to:*) [ -n "$CLAIM_AS" ] && continue;;
    esac
    _nl+=("$l")
  done
  [ -n "$CLAIM_AS" ] && _nl+=("to:$CLAIM_AS")
  for l in "${_nl[@]:-}"; do
    [ -z "$l" ] && continue
    args+=(-f "labels[]=$l")
  done
  if ! gh api -X PATCH "repos/$REPO/issues/$ISSUE" "${args[@]}" >/dev/null 2>&1; then
    # Не оставляем висячий claim: комментарий без перехода labels не должен
    # навсегда делать задачу BUSY. Удаляем только собственный комментарий.
    if [ -n "$claim_comment_id" ] && gh api -X DELETE "repos/$REPO/issues/comments/$claim_comment_id" >/dev/null 2>&1; then
      die "claim: не удалось перевести label в in-progress; собственный claim-комментарий #$claim_comment_id удалён, задача не заклинена"
    fi
    die "claim: не удалось перевести label в in-progress; проверьте claim-комментарий ${claim_comment_id:-без ID} вручную, чтобы задача не осталась BUSY"
  fi

  echo "CLAIMED: $claim_header"
  exit 0
}

[ -n "$CLAIM_ID" ] && do_claim

# --- цикл ожидания ---
DEADLINE=$(( $(date +%s) + TIMEOUT ))
WAIT_START="$(date -u +%Y-%m-%dT%H:%M:%SZ)"  # граница свежести для CI-сигнала (--sha)
while :; do
  RC=0
  OUT="$(check_signals)" || RC=$?
  [ "$RC" -eq 2 ] && exit 2  # die (404/401/403) в subshell не должен маскироваться таймаутом
  SIG="$(printf '%s\n' "$OUT" | grep '^SIGNAL' | head -n 1 || true)"
  if [ -n "$SIG" ]; then
    [ "$QUIET" -eq 0 ] && echo "[$(date -u +%H:%M:%SZ)] пойман сигнал в issue #$ISSUE ($REPO)" >&2
    echo "${SIG#SIGNAL }"
    exit 0
  fi
  [ "$QUIET" -eq 0 ] && echo "[$(date -u +%H:%M:%SZ)] issue #$ISSUE: сигнала нет; labels/комментарии/CI проверены, следующий поллинг через ${INTERVAL}с" >&2
  NOW=$(date +%s)
  [ "$NOW" -ge "$DEADLINE" ] && { echo "wait-signal: таймаут ${TIMEOUT}с без сигнала в issue #$ISSUE" >&2; exit 1; }
  REMAIN=$(( DEADLINE - NOW ))
  [ "$INTERVAL" -gt "$REMAIN" ] && sleep "$REMAIN" || sleep "$INTERVAL"
done
